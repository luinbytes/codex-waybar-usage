{
  "custom/grok-usage": {
    "exec": "$HOME/.local/share/grok-waybar-usage/grok-waybar.py",
    "return-type": "json",
    "interval": 180,
    "signal": 13,
    "tooltip": false
  },
  "custom/codex-usage": {
    "exec": "$HOME/.local/share/codex-waybar-usage/codex-waybar.py",
    "return-type": "json",
    "interval": 180,
    "signal": 13,
    "tooltip": false
  }
}
